# ==============================================================================
# Fermax Face Recognition Service - Environment Configuration
# ==============================================================================

# Puerto expuesto en el host
PORT=8000

# Rutas persistentes en el host (pueden ser relativas o absolutas)
DATA_PATH=./data
KNOWN_FACES_PATH=./known_faces

# Umbral de similitud para validar match facial (0.0 a 1.0)
SIMILARITY_THRESHOLD=0.65

# Tamaño de detección de rostros (320 rápido/ligero para CPU, 640 mayor precisión)
DET_SIZE=320
